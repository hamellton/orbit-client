<configuration>
  <!-- registered secrets (passwords, dosid, sessionID) are replaced with *** -->
  <conversionRule conversionWord="msg" converterClass="orbit.secrets.MaskingConverter"/>
  <conversionRule conversionWord="ex" converterClass="orbit.secrets.MaskingThrowableConverter"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n%ex</pattern>
    </encoder>
  </appender>

  <logger name="orbit.auth.HttpSession" level="DEBUG"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
